        "    except Exception as e:\n",
        "        return f\"❌ فشل قراءة JSON: {str(e)}\\nالرد كان: {response}\"\n",
        "\n",
        "def run_alpha3(zip_file, task):\n",
        "    if not zip_file or not task:\n",
        "        return \"❌ يرجى رفع ملف ZIP وكتابة الطلب.\", None\n",
        "\n",
        "    zip_path = zip_file if isinstance(zip_file, str) else zip_file.name\n",
        "    work_dir = \"project_workspace\"\n",
        "    if os.path.exists(work_dir):\n",
        "        shutil.rmtree(work_dir)\n",
        "\n",
        "    try:\n",
        "        safe_extract(zip_path, work_dir)\n",
        "        yield \"✅ تم فك ضغط المشروع. جاري التحليل...\", None\n",
        "\n",
        "        tree = get_file_tree(work_dir)\n",
        "        tree_str = \"\\n\".join(tree)\n",
        "\n",
        "        sys_prompt_plan = \"\"\"You are an Orchestrator AI.\n",
        "I will give you a list of files in a project and a user task.\n",
        "You MUST select the relevant files needed to complete the task.\n",
        "Output exactly in this JSON format:\n",
        "{\n",
        "  \"files_to_read\": [\"path/to/file1.py\", \"path/to/file2.py\"]\n",
        "}\n",
        "Do not output anything else.\"\"\"\n",
        "\n",
        "        user_prompt_plan = f\"Task: {task}\\n\\nProject Files Tree:\\n{tree_str}\"\n",
        "        plan_response = call_llm(sys_prompt_plan, user_prompt_plan)\n",
        "\n",
        "        if plan_response.startswith(\"ERROR:\"):\n",
        "            yield f\"❌ فشل الاتصال بالذكاء الاصطناعي: {plan_response}\", None\n",
        "            return\n",
        "\n",
        "        json_match = re.search(r'\\{.*\\}', plan_response, re.DOTALL)\n",
        "        if not json_match:\n",
        "            yield f\"❌ فشل المنسق في التخطيط. الرد: {plan_response}\", None\n",
        "            return\n",
        "\n",
        "        files_to_read = json.loads(json_match.group(0)).get(\"files_to_read\", [])\n",
        "\n",
        "        context = \"\"\n",
        "        for f in files_to_read:\n",
        "            file_path = os.path.join(work_dir, f)\n",
        "            if os.path.exists(file_path):\n",
        "                with open(file_path, 'r', encoding='utf-8') as file:\n",
        "                    context += f\"\\n### FILE: {f}\\n```\\n{file.read()}\\n```\\n\"\n",
        "\n",
        "        yield f\"✅ اختار المنسق {len(files_to_read)} ملف. جاري التعديل (Coder)...\", None\n",
        "\n",
        "        sys_prompt_coder = \"\"\"You are a Python Coder.\n",
        "Modify the provided code to achieve the task.\n",
        "You MUST output a JSON object containing the files to be modified or created.\n",
        "Format:\n",
        "{\n",
        "  \"operations\": [\n",
        "    {\"action\": \"replace_file\", \"path\": \"relative/path.py\", \"content\": \"full updated code\"},\n",
        "    {\"action\": \"create_file\", \"path\": \"relative/new.py\", \"content\": \"full new code\"}\n",
        "  ]\n",
        "}\n",
        "Output ONLY the JSON. Do not include markdown or explanations.\"\"\"\n",
        "\n",
        "        user_prompt_coder = f\"Task: {task}\\n\\nCurrent Code:\\n{context}\"\n",
        "        coder_response = call_llm(sys_prompt_coder, user_prompt_coder)\n",
        "\n",
        "        if coder_response.startswith(\"ERROR:\"):\n",
        "            yield f\"❌ فشل الاتصال بالذكاء الاصطناعي (Coder): {coder_response}\", None\n",
        "            return\n",
        "\n",
        "        apply_msg = apply_operations(coder_response, work_dir)\n",
        "        yield f\"✅ المبرمج انتهى. {apply_msg}\\n\\n⏳ جاري تشغيل الاختبارات...\", None\n",
        "\n",
        "        max_retries = 3\n",
        "        for attempt in range(max_retries):\n",
        "            result = subprocess.run([\"pytest\", work_dir, \"-v\"], capture_output=True, text=True, timeout=30)\n",
        "\n",
        "            if result.returncode == 0:\n",
        "                status_msg = f\"✅ الاختبارات نجحت! (المحاولة {attempt+1})\"\n",
        "                break\n",
        "            else:\n",
        "                status_msg = f\"❌ الاختبارات فشلت (المحاولة {attempt+1}/{max_retries}). جاري الإصلاح...\"\n",
        "                yield status_msg, None\n",
        "\n",
        "                if attempt == max_retries - 1:\n",
        "                    status_msg = f\"⚠️ فشل الإصلاح بعد {max_retries} محاولات.\\n\\n**الخطأ:**\\n```\\n{result.stdout[:400]}\\n```\"\n",
        "                    break\n",
        "\n",
        "                context_after_mod = \"\"\n",
        "                for f in os.listdir(work_dir):\n",
        "                    if f.endswith(\".py\"):\n",
        "                        with open(os.path.join(work_dir, f), 'r', encoding='utf-8') as file:\n",
        "                            context_after_mod += f\"\\n### FILE: {f}\\n```\\n{file.read()}\\n```\\n\"\n",
        "\n",
        "                sys_prompt_debug = \"\"\"You are a Python Debugger.\n",
        "Fix the code based on the pytest error.\n",
        "Output ONLY a JSON object:\n",
        "{\n",
        "  \"operations\": [\n",
        "    {\"action\": \"replace_file\", \"path\": \"relative/path.py\", \"content\": \"full fixed code\"}\n",
        "  ]\n",
        "}\"\"\"\n",
        "                user_prompt_debug = f\"Code:\\n{context_after_mod}\\n\\nError:\\n{result.stdout}\"\n",
        "                debug_response = call_llm(sys_prompt_debug, user_prompt_debug)\n",
        "\n",
        "                if debug_response.startswith(\"ERROR:\"):\n",
        "                    yield f\"❌ فشل الاتصال بالذكاء الاصطناعي (Debugger): {debug_response}\", None\n",
        "                    return\n",
        "\n",
        "                apply_msg_debug = apply_operations(debug_response, work_dir)\n",
        "                yield f\"🛠️ المصحح تدخل. {apply_msg_debug}\\n\\n⏳ إعادة الاختبار...\", None\n",
        "\n",
        "        output_zip = \"updated_project.zip\"\n",
        "        with zipfile.ZipFile(output_zip, 'w', zipfile.ZIP_DEFLATED) as zipf:\n",
        "            for root, dirs, files in os.walk(work_dir):\n",
        "                for file in files:\n",
        "                    full_path = os.path.join(root, file)\n",
        "                    rel_path = os.path.relpath(full_path, work_dir)\n",
        "                    zipf.write(full_path, rel_path)\n",
        "\n",
        "        yield f\"{status_msg}\\n\\nتم تجهيز الملف للتحميل.\", output_zip\n",
        "\n",
        "    except Exception as e:\n",
        "        yield f\"❌ حدث خطأ: {str(e)}\", None\n",
        "\n",
        "with gr.Blocks(title=\"AI-Workforce v2.1 (Alpha 3)\") as iface:\n",
