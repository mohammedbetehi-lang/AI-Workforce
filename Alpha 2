        "\n",
        "    with gr.Row():\n",
        "        with gr.Column():\n",
        "            zip_input = gr.File(label=\"ارفع ملف المشروع (ZIP)\", file_types=[\".zip\"])\n",
        "            task_input = gr.Textbox(label=\"طلبك\", lines=3)\n",
        "            submit_btn = gr.Button(\"🚀 بدء التعديل\", variant=\"primary\")\n",
        "\n",
        "        with gr.Column():\n",
        "            status_output = gr.Markdown(label=\"حالة التنفيذ\")\n",
        "            file_output = gr.File(label=\"تحميل المشروع المعدل (ZIP)\")\n",
        "\n",
        "    submit_btn.click(fn=run_alpha3, inputs=[zip_input, task_input], outputs=[status_output, file_output])\n",
