        "import requests\n",
        "import json\n",
        "import subprocess\n",
        "import os\n",
        "import re\n",
        "import getpass\n",
        "\n",
        "# --- 1. إعدادات الاتصال بالذكاء الاصطناعي ---\n",
        "print(\"🔑 يرجى إدخال مفتاح OpenRouter الخاص بك (لن يظهر على الشاشة):\")\n",
        "api_key = getpass.getpass(\"API Key: \")\n",
        "\n",
        "def call_llm(system_prompt, user_prompt):\n",
        "    url = \"https://openrouter.ai/api/v1/chat/completions\"\n",
        "    headers = {\n",
        "        \"Authorization\": f\"Bearer {api_key}\",\n",
        "        \"Content-Type\": \"application/json\"\n",
        "    }\n",
        "    data = {\n",
        "        \"model\": \"deepseek/deepseek-chat\",\n",
        "        \"messages\": [\n",
        "            {\"role\": \"system\", \"content\": system_prompt},\n",
        "            {\"role\": \"user\", \"content\": user_prompt}\n",
        "        ]\n",
        "    }\n",
        "    response = requests.post(url, headers=headers, json=data)\n",
        "    return response.json()[\"choices\"][0][\"message\"][\"content\"]\n",
        "\n",
        "# --- 2. دالة لاستخراج الكود من رد الـ AI ---\n",
        "def extract_code(text):\n",
        "    match = re.search(r\"```python\\n(.*?)\\n```\", text, re.DOTALL)\n",
        "    return match.group(1) if match else text\n",
        "\n",
        "# --- 3. الوكلاء (The Agents) ---\n",
        "\n",
        "def coder_agent(task):\n",
        "    print(\"\\n🤖 [Coder] جاري كتابة الكود والاختبارات...\")\n",
        "    sys_prompt = \"You are a Coder. Write Python code and pytest tests. Output the code for 'main.py', then the code for 'test_main.py'. Separate them with exactly '---TEST---'.\"\n",
        "    response = call_llm(sys_prompt, task)\n",
        "\n",
        "    # نفصلوا الكود عن الاختبار\n",
        "    parts = response.split(\"---TEST---\")\n",
        "    main_code = extract_code(parts[0])\n",
        "    test_code = extract_code(parts[1]) if len(parts) > 1 else \"\"\n",
        "\n",
        "    # نحفظوهم في ملفات حقيقية\n",
        "    with open(\"extracted/main.py\", \"w\") as f: f.write(main_code)\n",
        "    with open(\"extracted/test_main.py\", \"w\") as f: f.write(test_code)\n",
        "    print(\"✅ [Coder] تم حفظ main.py و test_main.py\")\n",
        "\n",
        "def tester_agent():\n",
        "    print(\"🧪 [Tester] جاري تشغيل pytest...\")\n",
        "    result = subprocess.run([\"pytest\", \"extracted/test_main.py\", \"-v\"], capture_output=True, text=True)\n",
        "    if result.returncode == 0:\n",
        "        print(\"✅ [Tester] الاختبارات نجحت! (PASS)\")\n",
        "        return True, \"\"\n",
        "    else:\n",
        "        print(\"❌ [Tester] الاختبارات فشلت! (FAIL)\")\n",
        "        return False, result.stdout\n",
        "\n",
        "def debugger_agent(error_log):\n",
        "    print(\"\\n🛠️ [Debugger] جاري تحليل الخطأ وإصلاح الكود...\")\n",
        "    with open(\"extracted/main.py\", \"r\") as f: buggy_code = f.read()\n",
