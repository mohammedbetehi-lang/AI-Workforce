    {
      "cell_type": "code",
      "source": [
        "# 1. تثبيت المكتبات\n",
        "!pip install gradio requests json-repair -q\n",
        "\n",
        "# 2. ربط Google Drive\n",
        "import os\n",
        "try:\n",
        "    from google.colab import drive\n",
        "    drive.mount('/content/drive')\n",
        "    BASE_DIR = \"/content/drive/MyDrive/AI-Workforce\"\n",
        "except ImportError:\n",
        "    BASE_DIR = \"AI-Workforce_Local\"\n",
        "\n",
        "os.makedirs(BASE_DIR, exist_ok=True)\n",
        "\n",
        "import gradio as gr\n",
        "import requests\n",
        "import json\n",
        "import json_repair\n",
        "import subprocess\n",
        "import re\n",
        "import getpass\n",
        "import zipfile\n",
        "import shutil\n",
        "import difflib\n",
        "import html\n",
        "import uuid\n",
        "import datetime\n",
        "from pathlib import Path\n",
        "\n",
        "# 3. مفتاح OpenRouter\n",
        "try:\n",
        "    from google.colab import userdata\n",
        "    api_key = userdata.get('OPENROUTER_API_KEY')\n",
        "    if not api_key: raise ValueError\n",
        "except:\n",
        "    print(\"🔑 يرجى إدخال مفتاح OpenRouter الخاص بك:\")\n",
        "    api_key = getpass.getpass(\"API Key: \")\n",
        "\n",
        "HISTORY_FILE = os.path.join(BASE_DIR, \"chat_history.json\")\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# إدارة السجل\n",
        "# ---------------------------------------------------------\n",
        "def load_history():\n",
        "    if os.path.exists(HISTORY_FILE):\n",
        "        with open(HISTORY_FILE, \"r\", encoding=\"utf-8\") as f: return json.load(f)\n",
        "    return {}\n",
        "\n",
        "def save_history(session_id, title, task, plan, diff, status):\n",
        "    history = load_history()\n",
        "    history[session_id] = {\n",
        "        \"title\": title, \"task\": task, \"plan\": plan, \"diff\": diff, \"status\": status,\n",
        "        \"timestamp\": datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "    }\n",
        "    with open(HISTORY_FILE, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(history, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "def get_history_list():\n",
        "    history = load_history()\n",
        "    return [f\"{v['timestamp']} - {v['title']}\" for k, v in reversed(list(history.items()))]\n",
        "\n",
        "def load_from_history(selected_title):\n",
        "    if not selected_title: return \"\", \"\", \"\", \"\", \"\"\n",
        "    history = load_history()\n",
        "    for k, v in history.items():\n",
        "        if f\"{v['timestamp']} - {v['title']}\" == selected_title:\n",
        "            return v['task'], v['plan'], v['diff'], v['status'], k\n",
        "    return \"\", \"\", \"\", \"\", \"\"\n",
        "\n",
        "def delete_history(selected_title, current_session_id):\n",
        "    if not selected_title:\n",
        "        return \"⚠️ يرجى اختيار محادثة لحذفها.\", current_session_id, gr.update()\n",
        "\n",
        "    history = load_history()\n",
        "    target_id = None\n",
        "\n",
        "    for k, v in history.items():\n",
        "        if f\"{v['timestamp']} - {v['title']}\" == selected_title:\n",
        "            target_id = k\n",
        "            break\n",
        "\n",
        "    if not target_id:\n",
        "        return \"❌ لم يتم العثور على المحادثة.\", current_session_id, gr.update()\n",
        "\n",
        "    # حذف من ملف السجل\n",
        "    del history[target_id]\n",
        "    with open(HISTORY_FILE, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(history, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "    # حذف مجلد الجلسة من Drive\n",
        "    session_folder = os.path.join(BASE_DIR, \"sessions\", target_id)\n",
        "    if os.path.exists(session_folder):\n",
        "        shutil.rmtree(session_folder, ignore_errors=True)\n",
        "\n",
        "    # إذا كانت المحادثة المحذوفة هي المفتوحة حالياً، نبدأ جلسة جديدة\n",
        "    new_session = current_session_id\n",
        "    if current_session_id == target_id:\n",
        "        new_session = get_session_dir()\n",
        "\n",
        "    new_list = get_history_list()\n",
        "\n",
        "    # تحديث القائمة وتفريغ التحديد\n",
        "    return f\"✅ تم حذف المحادثة: {selected_title}\", new_session, gr.update(choices=new_list, value=None)\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# دوال AI والأمان\n",
        "# ---------------------------------------------------------\n",
        "def call_llm(system_prompt, user_prompt):\n",
        "    url = \"https://openrouter.ai/api/v1/chat/completions\"\n",
        "    headers = {\"Authorization\": f\"Bearer {api_key}\", \"Content-Type\": \"application/json\"}\n",
        "    data = {\"model\": \"openrouter/free\", \"max_tokens\": 16000, \"messages\": [{\"role\": \"system\", \"content\": system_prompt}, {\"role\": \"user\", \"content\": user_prompt}]}\n",
        "    for attempt in range(3):\n",
        "        try:\n",
        "            response = requests.post(url, headers=headers, json=data, timeout=120)\n",
        "            response_data = response.json()\n",
        "            if \"error\" in response_data: continue\n",
        "            if \"choices\" not in response_data: continue\n",
        "            content = response_data[\"choices\"][0][\"message\"][\"content\"]\n",
        "            if not content or content.strip() == \"\": continue\n",
        "            return str(content)\n",
        "        except: pass\n",
        "    return \"ERROR: Empty response.\"\n",
        "\n",
        "def safe_extract(zip_path, extract_to):\n",
        "    extract_to_path = Path(extract_to).resolve()\n",
        "    os.makedirs(extract_to_path, exist_ok=True)\n",
        "    with zipfile.ZipFile(zip_path, 'r') as zip_ref:\n",
        "        for member in zip_ref.namelist():\n",
        "            member_path = Path(extract_to_path, member).resolve()\n",
        "            if not member_path.is_relative_to(extract_to_path) or member_path.is_symlink(): continue\n",
        "            zip_ref.extract(member, extract_to_path)\n",
        "\n",
        "def get_file_tree(directory):\n",
        "    tree = []\n",
        "    ignore_dirs = {'.git', 'node_modules', 'venv', '.venv', '__pycache__', 'dist', 'build'}\n",
        "    for root, dirs, files in os.walk(directory):\n",
        "        dirs[:] = [d for d in dirs if d not in ignore_dirs]\n",
        "        for file in files:\n",
        "            if file.endswith(('.py', '.js', '.html', '.css', '.txt', '.md', '.json', '.toml')):\n",
        "                rel_path = os.path.relpath(os.path.join(root, file), directory)\n",
        "                tree.append(rel_path)\n",
        "    return tree\n",
        "\n",
        "def clean_content(content):\n",
        "    if not isinstance(content, str): return content\n",
        "    content = content.replace('\\\\\\\\', '\\\\').replace('\\\\n', '\\n').replace('\\\\t', '\\t')\n",
        "    content = content.replace('\\\\\"', '\"').replace(\"\\\\'\", \"'\").replace('\\\\`', '`').replace('\\\\$', '$')\n",
        "    return content\n",
        "\n",
        "def apply_operations(response, work_dir):\n",
        "    work_dir_path = Path(work_dir).resolve()\n",
        "    try:\n",
        "        if not response or response.startswith(\"ERROR:\"): return f\"❌ فشل: {response}\"\n",
        "        try:\n",
        "            data = json_repair.loads(response)\n",
        "            if not data or \"operations\" not in data:\n",
        "                 json_match = re.search(r'\\{.*\\}', response, re.DOTALL)\n",
        "                 if json_match: data = json_repair.loads(json_match.group(0))\n",
        "        except: return \"❌ فشل قراءة JSON.\"\n",
        "\n",
        "        ops = data.get(\"operations\", [])\n",
        "        applied_count = 0\n",
        "        for op in ops:\n",
        "            action = op.get(\"action\")\n",
        "            rel_path = op.get(\"path\")\n",
        "            content = op.get(\"content\", \"\")\n",
        "            if not rel_path or not isinstance(rel_path, str): continue\n",
        "            filename = os.path.basename(rel_path)\n",
        "            if filename.startswith(\"test_\") or \"/test_\" in rel_path: continue\n",
        "\n",
        "            content = clean_content(content)\n",
        "            file_path = (work_dir_path / rel_path).resolve()\n",
        "            if not file_path.is_relative_to(work_dir_path) or file_path.is_symlink(): continue\n",
        "\n",
        "            if action in [\"replace_file\", \"create_file\"]:\n",
        "                os.makedirs(file_path.parent, exist_ok=True)\n",
        "                with open(file_path, 'w', encoding='utf-8') as f: f.write(content)\n",
        "                applied_count += 1\n",
        "        return f\"✅ تم تطبيق {applied_count} تعديل.\"\n",
        "    except Exception as e: return f\"❌ فشل: {str(e)}\"\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# التحليل والتنفيذ\n",
        "# ---------------------------------------------------------\n",
        "def analyze_project(zip_file, task, project_type, session_dir):\n",
        "    if not task:\n",
        "        return \"❌ يرجى كتابة طلبك.\", \"\", \"\", \"\", gr.update(), session_dir\n",
        "\n",
        "    if not session_dir or not isinstance(session_dir, str):\n",
        "        session_dir = get_session_dir()\n",
        "\n",
        "    work_dir = os.path.join(session_dir, \"project_workspace\")\n",
        "    if os.path.exists(work_dir): shutil.rmtree(work_dir)\n",
        "    os.makedirs(work_dir, exist_ok=True)\n",
        "\n",
        "    try:\n",
        "        context = \"\"\n",
        "        if zip_file is not None:\n",
        "            zip_path = zip_file if isinstance(zip_file, str) else zip_file.name\n",
        "            safe_extract(zip_path, work_dir)\n",
        "            tree = get_file_tree(work_dir)\n",
        "            tree_str = \"\\n\".join(tree)\n",
        "\n",
        "            sys_prompt_plan = \"\"\"You are a Senior Software Architect. Select relevant files to read based on the task. Output JSON: {\"files_to_read\": [\"path/to/file1.py\"]}\"\"\"\n",
        "            plan_response = call_llm(sys_prompt_plan, f\"Task: {task}\\n\\nFiles:\\n{tree_str}\")\n",
        "\n",
        "            json_match = re.search(r'\\{.*\\}', plan_response, re.DOTALL)\n",
        "            if json_match:\n",
        "                try:\n",
        "                    files_to_read = json_repair.loads(json_match.group(0)).get(\"files_to_read\", [])\n",
        "                    for f in files_to_read:\n",
        "                        file_path = (Path(work_dir) / f).resolve()\n",
        "                        if file_path.is_relative_to(Path(work_dir).resolve()) and file_path.is_file():\n",
        "                            with open(file_path, 'r', encoding='utf-8') as file:\n",
        "                                context += f\"\\n### FILE: {f}\\n```\\n{file.read()}\\n```\\n\"\n",
        "                except: pass\n",
        "\n",
        "        if project_type == \"Static Website (HTML/CSS/JS)\":\n",
        "            sys_prompt_coder = \"\"\"You are an Expert Front-End Developer. Build a complete multi-file static website. Create index.html, style.css, and script.js. Use Bootstrap 5 via CDN. NO Template Literals. Output ONLY JSON: {\"operations\": [{\"action\": \"create_file\", \"path\": \"index.html\", \"content\": \"...\"}]}\"\"\"\n",
        "        else:\n",
        "            sys_prompt_coder = \"\"\"You are an Expert Full-Stack Python Developer. Build a Flask web application. Create app.py, templates/index.html, static/style.css. Output ONLY JSON: {\"operations\": [{\"action\": \"create_file\", \"path\": \"app.py\", \"content\": \"...\"}]}\"\"\"\n",
        "\n",
        "        coder_response = call_llm(sys_prompt_coder, f\"Task: {task}\\n\\nCurrent Code:\\n{context}\")\n",
        "        if coder_response.startswith(\"ERROR:\"):\n",
        "            return f\"❌ فشل الاتصال: {coder_response}\", \"\", \"\", \"\", gr.update(), session_dir\n",
        "\n",
        "        pending_file = os.path.join(session_dir, \"pending_operations.json\")\n",
        "        with open(pending_file, \"w\", encoding=\"utf-8\") as f: f.write(coder_response)\n",
        "\n",
        "        try:\n",
        "            data = json_repair.loads(coder_response)\n",
        "            if not data or \"operations\" not in data:\n",
        "                json_match_ops = re.search(r'\\{.*\\}', coder_response, re.DOTALL)\n",
        "                if json_match_ops: data = json_repair.loads(json_match_ops.group(0))\n",
        "            ops_data = data.get(\"operations\", [])\n",
        "        except:\n",
        "            return f\"⚠️ فشل قراءة JSON.\\n\\n**الرد الخام:**\\n```\\n{coder_response[:1000]}\\n```\", \"\", \"فشل التخطيط\", \"\", gr.update(), session_dir\n",
        "\n",
        "        if not ops_data:\n",
        "            return f\"⚠️ العمليات فارغة.\\n\\n**الرد الخام:**\\n```\\n{coder_response[:1000]}\\n```\", \"\", \"فشل التخطيط\", \"\", gr.update(), session_dir\n",
        "\n",
        "        plan_display = \"✅ تم التحليل.\\n\\n**التعديلات المقترحة:**\\n\"\n",
        "        diff_display = \"\"\n",
        "        html_content, css_content, js_content = \"\", \"\", \"\"\n",
        "\n",
        "        for op in ops_data:\n",
        "            action = op.get('action')\n",
        "            rel_path = op.get('path')\n",
        "            new_content = clean_content(op.get('content', ''))\n",
        "            if not rel_path: continue\n",
        "            plan_display += f\"- [{action}] : {rel_path}\\n\"\n",
        "\n",
        "            if rel_path.endswith('.html'): html_content = new_content\n",
        "            if rel_path.endswith('.css'): css_content = new_content\n",
        "            if rel_path.endswith('.js'): js_content = new_content\n",
        "\n",
        "            file_path = os.path.join(work_dir, rel_path)\n",
        "            old_content = \"\"\n",
        "            if os.path.exists(file_path) and action == \"replace_file\" and os.path.isfile(file_path):\n",
        "                with open(file_path, 'r', encoding='utf-8') as file: old_content = file.read()\n",
        "\n",
        "            diff_display += f\"\\n### 📝 Diff for: {rel_path}\\n\"\n",
        "            diff = list(difflib.unified_diff(old_content.splitlines(), new_content.splitlines(), fromfile='Original', tofile='Modified', lineterm=''))\n",
        "            if diff:\n",
        "                for line in diff:\n",
        "                    safe_line = html.escape(line)\n",
        "                    if line.startswith('+') and not line.startswith('+++'): diff_display += f\"<span style='color: green;'>{safe_line}</span>\\n\"\n",
        "                    elif line.startswith('-') and not line.startswith('---'): diff_display += f\"<span style='color: red;'>{safe_line}</span>\\n\"\n",
        "                    else: diff_display += f\"{safe_line}\\n\"\n",
        "            else: diff_display += \"(ملف جديد)\\n\"\n",
        "\n",
        "        preview_html = \"\"\n",
        "        if html_content:\n",
        "            if css_content: html_content = html_content.replace(\"</head>\", f\"<style>{css_content}</style>\\n</head>\")\n",
        "            if js_content: html_content = html_content.replace(\"</body>\", f\"<script>{js_content}</script>\\n</body>\")\n",
        "            preview_html = html_content\n",
        "\n",
        "        save_history(session_dir, task[:30], task, plan_display, diff_display, \"بانتظار الموافقة\")\n",
        "\n",
        "        # تحديث القائمة\n",
        "        new_list = get_history_list()\n",
        "        return plan_display, diff_display, \"الخطة جاهزة.\", preview_html, gr.update(choices=new_list, value=None), session_dir\n",
        "\n",
        "    except Exception as e:\n",
        "        return f\"❌ حدث خطأ: {str(e)}\", \"\", \"\", \"\", gr.update(), session_dir\n",
        "\n",
        "def execute_project(session_dir):\n",
        "    if not session_dir or not isinstance(session_dir, str):\n",
        "        yield \"❌ جلسة غير صالحة. يرجى الضغط على 'تحليل' أولاً.\", \"\", None, gr.update()\n",
        "        return\n",
        "\n",
        "    work_dir = os.path.join(session_dir, \"project_workspace\")\n",
        "    pending_file = os.path.join(session_dir, \"pending_operations.json\")\n",
        "\n",
        "    if not os.path.exists(pending_file) or not os.path.exists(work_dir):\n",
        "        yield \"❌ لا توجد خطة محفوظة. يرجى الضغط على 'تحليل' أولاً.\", \"\", None, gr.update()\n",
        "        return\n",
        "\n",
        "    try:\n",
        "        with open(pending_file, \"r\", encoding=\"utf-8\") as f: coder_response = f.read()\n",
        "        apply_msg = apply_operations(coder_response, work_dir)\n",
        "        status_log = f\"✅ الموافقة تمت. {apply_msg}\\n\\n⏳ جاري تشغيل الاختبار...\\n\"\n",
        "        yield status_log, \"\", None, gr.update()\n",
        "\n",
        "        has_py = any(f.suffix == '.py' for f in Path(work_dir).rglob('*.py'))\n",
        "        final_status = \"FAILED\"\n",
        "\n",
        "        if has_py:\n",
        "            result = subprocess.run([\"pytest\", work_dir, \"-v\", \"--tb=short\"], capture_output=True, text=True, timeout=30)\n",
        "            full_log = result.stdout + \"\\n\" + result.stderr\n",
        "            if result.returncode == 0:\n",
        "                status_log += \"\\n✅ الاختبارات نجحت!\"\n",
        "                final_status = \"PASS\"\n",
        "            else:\n",
        "                status_log += f\"\\n❌ الاختبارات فشلت.\\n\"\n",
        "                yield status_log, \"\", None, gr.update()\n",
        "                for attempt in range(3):\n",
        "                    status_log += f\"\\n🛠️ محاولة الإصلاح {attempt+1}/3...\\n\"\n",
        "                    yield status_log, \"\", None, gr.update()\n",
        "                    context_after_mod = \"\"\n",
        "                    for root, dirs, files in os.walk(work_dir):\n",
        "                        for file in files:\n",
        "                            if file.endswith(\".py\"):\n",
        "                                full_path = os.path.join(root, file)\n",
        "                                rel_path = os.path.relpath(full_path, work_dir)\n",
        "                                with open(full_path, 'r', encoding='utf-8') as f: context_after_mod += f\"\\n### FILE: {rel_path}\\n```\\n{f.read()}\\n```\\n\"\n",
        "\n",
        "                    sys_prompt_debug = \"\"\"You are a Python Debugger. Fix the bug. Output ONLY JSON: {\"operations\": [{\"action\": \"replace_file\", \"path\": \"EXACT_PATH.py\", \"content\": \"...\"}]}\"\"\"\n",
        "                    debug_response = call_llm(sys_prompt_debug, f\"Code:\\n{context_after_mod}\\n\\nError:\\n{full_log}\")\n",
        "                    if debug_response.startswith(\"ERROR:\"): break\n",
        "                    apply_operations(debug_response, work_dir)\n",
        "                    result = subprocess.run([\"pytest\", work_dir, \"-v\", \"--tb=short\"], capture_output=True, text=True, timeout=30)\n",
        "                    full_log = result.stdout + \"\\n\" + result.stderr\n",
        "                    if result.returncode == 0:\n",
        "                        status_log += f\"\\n✅ الاختبارات نجحت بعد الإصلاح!\"\n",
        "                        final_status = \"PASS\"\n",
        "                        break\n",
        "        else:\n",
        "            status_log += \"\\n✅ لا توجد ملفات بايثون لاختبارها.\"\n",
        "            final_status = \"PASS\"\n",
        "\n",
        "        output_zip = os.path.join(session_dir, \"updated_project.zip\")\n",
        "        with zipfile.ZipFile(output_zip, 'w', zipfile.ZIP_DEFLATED) as zipf:\n",
        "            for root, dirs, files in os.walk(work_dir):\n",
        "                for file in files:\n",
        "                    full_path = os.path.join(root, file)\n",
        "                    rel_path = os.path.relpath(full_path, work_dir)\n",
        "                    zipf.write(full_path, rel_path)\n",
        "\n",
        "        status_log += f\"\\n\\n🎁 تم تجهيز الملف. الحالة: {final_status}\"\n",
        "\n",
        "        history = load_history()\n",
        "        if session_dir in history:\n",
        "            history[session_dir]['status'] = final_status\n",
        "            with open(HISTORY_FILE, \"w\", encoding=\"utf-8\") as f: json.dump(history, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "        preview_html = \"\"\n",
        "        html_file = os.path.join(work_dir, \"index.html\")\n",
        "        if os.path.exists(html_file):\n",
        "            with open(html_file, 'r', encoding='utf-8') as f: html_content = f.read()\n",
        "            css_file = os.path.join(work_dir, \"style.css\")\n",
        "            if os.path.exists(css_file):\n",
        "                with open(css_file, 'r', encoding='utf-8') as f: css_content = f.read()\n",
        "                html_content = html_content.replace(\"</head>\", f\"<style>{css_content}</style>\\n</head>\")\n",
        "            js_file = os.path.join(work_dir, \"script.js\")\n",
        "            if os.path.exists(js_file):\n",
        "                with open(js_file, 'r', encoding='utf-8') as f: js_content = f.read()\n",
        "                html_content = html_content.replace(\"</body>\", f\"<script>{js_content}</script>\\n</body>\")\n",
