      "source": [
        "!pip install gradio requests json-repair -q\n",
        "\n",
        "import gradio as gr\n",
        "import requests\n",
        "import json\n",
        "import json_repair\n",
        "import subprocess\n",
        "import os\n",
        "import re\n",
        "import getpass\n",
        "import zipfile\n",
        "import shutil\n",
        "import difflib\n",
        "import html\n",
        "import uuid\n",
        "import datetime\n",
        "from pathlib import Path\n",
        "\n",
        "print(\"🔑 يرجى إدخال مفتاح OpenRouter الخاص بك:\")\n",
        "api_key = getpass.getpass(\"API Key: \")\n",
        "\n",
        "HISTORY_FILE = \"chat_history.json\"\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# إدارة سجل المحادثات\n",
        "# ---------------------------------------------------------\n",
        "def load_history():\n",
        "    if os.path.exists(HISTORY_FILE):\n",
        "        with open(HISTORY_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "            return json.load(f)\n",
        "    return {}\n",
        "\n",
        "def save_history(session_id, title, task, plan, diff, status):\n",
        "    history = load_history()\n",
        "    history[session_id] = {\n",
        "        \"title\": title,\n",
        "        \"task\": task,\n",
        "        \"plan\": plan,\n",
        "        \"diff\": diff,\n",
        "        \"status\": status,\n",
        "        \"timestamp\": datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "    }\n",
        "    with open(HISTORY_FILE, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(history, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "def get_history_list():\n",
        "    history = load_history()\n",
        "    return [f\"{v['timestamp']} - {v['title']}\" for k, v in reversed(list(history.items()))]\n",
        "\n",
        "def load_from_history(selected_title):\n",
        "    if not selected_title:\n",
        "        return \"\", \"\", \"\", \"\", \"\"\n",
        "    history = load_history()\n",
        "    for k, v in history.items():\n",
        "        if f\"{v['timestamp']} - {v['title']}\" == selected_title:\n",
        "            return v['task'], v['plan'], v['diff'], v['status'], k\n",
        "    return \"\", \"\", \"\", \"\", \"\"\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# دوال الذكاء الاصطناعي\n",
        "# ---------------------------------------------------------\n",
        "def call_llm(system_prompt, user_prompt):\n",
        "    url = \"https://openrouter.ai/api/v1/chat/completions\"\n",
        "    headers = {\"Authorization\": f\"Bearer {api_key}\", \"Content-Type\": \"application/json\"}\n",
        "    data = {\n",
        "        \"model\": \"openrouter/free\",  # <--- نموذج ذكي وموثوق (تم التعديل)\n",
        "        \"max_tokens\": 16000,         # <--- زدنا التوكنات (تم التعديل)\n",
        "        \"messages\": [{\"role\": \"system\", \"content\": system_prompt}, {\"role\": \"user\", \"content\": user_prompt}]\n",
        "    }\n",
        "\n",
        "    for attempt in range(3):\n",
        "        try:\n",
        "            response = requests.post(url, headers=headers, json=data, timeout=120)\n",
        "            response_data = response.json()\n",
        "\n",
        "            if \"error\" in response_data:\n",
        "                print(f\"محاولة {attempt+1} فشلت: {response_data['error'].get('message')}\")\n",
        "                continue\n",
        "\n",
        "            if \"choices\" not in response_data:\n",
        "                print(f\"محاولة {attempt+1} رجعت رد غير متوقع.\")\n",
        "                continue\n",
        "\n",
        "            content = response_data[\"choices\"][0][\"message\"][\"content\"]\n",
        "\n",
        "            if not content or content.strip() == \"\":\n",
        "                print(f\"محاولة {attempt+1} رجعت رد فارغ. جاري إعادة المحاولة...\")\n",
        "                continue\n",
        "\n",
        "            return str(content)\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"محاولة {attempt+1} واجهت خطأ: {str(e)}\")\n",
        "\n",
        "    return \"ERROR: The model returned an empty response after 3 attempts.\"\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# أدوات الأمان والتعامل مع الملفات\n",
        "# ---------------------------------------------------------\n",
        "def safe_extract(zip_path, extract_to):\n",
        "    extract_to_path = Path(extract_to).resolve()\n",
        "    os.makedirs(extract_to_path, exist_ok=True)\n",
        "    with zipfile.ZipFile(zip_path, 'r') as zip_ref:\n",
        "        for member in zip_ref.namelist():\n",
        "            member_path = Path(extract_to_path, member).resolve()\n",
        "            if not member_path.is_relative_to(extract_to_path) or member_path.is_symlink():\n",
        "                continue\n",
        "            zip_ref.extract(member, extract_to_path)\n",
        "\n",
        "def get_file_tree(directory):\n",
        "    tree = []\n",
        "    ignore_dirs = {'.git', 'node_modules', 'venv', '.venv', '__pycache__', 'dist', 'build'}\n",
        "    for root, dirs, files in os.walk(directory):\n",
        "        dirs[:] = [d for d in dirs if d not in ignore_dirs]\n",
        "        for file in files:\n",
        "            if file.endswith(('.py', '.js', '.html', '.css', '.txt', '.md', '.json', '.toml')):\n",
        "                rel_path = os.path.relpath(os.path.join(root, file), directory)\n",
        "                tree.append(rel_path)\n",
        "    return tree\n",
        "\n",
        "def clean_content(content):\n",
        "    if not isinstance(content, str):\n",
        "        return content\n",
        "    content = content.replace('\\\\\\\\', '\\\\')\n",
        "    content = content.replace('\\\\n', '\\n')\n",
        "    content = content.replace('\\\\t', '\\t')\n",
        "    content = content.replace('\\\\\"', '\"')\n",
        "    content = content.replace(\"\\\\'\", \"'\")\n",
        "    content = content.replace('\\\\`', '`')\n",
        "    content = content.replace('\\\\$', '$')\n",
        "    return content\n",
        "\n",
        "def apply_operations(response, work_dir):\n",
        "    work_dir_path = Path(work_dir).resolve()\n",
        "    try:\n",
        "        if not response or response.startswith(\"ERROR:\"):\n",
        "            return f\"❌ فشل التطبيق: {response}\"\n",
        "\n",
        "        try:\n",
        "            data = json_repair.loads(response)\n",
        "            if not data or \"operations\" not in data:\n",
        "                 json_match = re.search(r'\\{.*\\}', response, re.DOTALL)\n",
        "                 if json_match:\n",
        "                     data = json_repair.loads(json_match.group(0))\n",
        "        except:\n",
        "             return \"❌ فشل قراءة JSON.\"\n",
        "\n",
        "        ops = data.get(\"operations\", [])\n",
        "        applied_count = 0\n",
        "\n",
        "        for op in ops:\n",
        "            action = op.get(\"action\")\n",
        "            rel_path = op.get(\"path\")\n",
        "            content = op.get(\"content\", \"\")\n",
        "\n",
        "            if not rel_path or not isinstance(rel_path, str):\n",
        "                continue\n",
        "\n",
        "            content = clean_content(content)\n",
        "\n",
        "            file_path = (work_dir_path / rel_path).resolve()\n",
        "\n",
        "            if not file_path.is_relative_to(work_dir_path) or file_path.is_symlink():\n",
        "                continue\n",
        "\n",
        "            if action in [\"replace_file\", \"create_file\"]:\n",
        "                os.makedirs(file_path.parent, exist_ok=True)\n",
        "                with open(file_path, 'w', encoding='utf-8') as f:\n",
        "                    f.write(content)\n",
        "                applied_count += 1\n",
        "\n",
        "        return f\"✅ تم تطبيق {applied_count} تعديل بنجاح.\"\n",
        "    except Exception as e:\n",
        "        return f\"❌ فشل التطبيق: {str(e)}\"\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# تحليل المشروع وكتابة الخطة\n",
        "# ---------------------------------------------------------\n",
        "def analyze_project(zip_file, task, session_dir):\n",
        "    if not task:\n",
        "        return \"❌ يرجى كتابة طلبك.\", \"\", \"\", \"\"\n",
        "\n",
        "    work_dir = os.path.join(session_dir, \"project_workspace\")\n",
        "    if os.path.exists(work_dir):\n",
        "        shutil.rmtree(work_dir)\n",
        "    os.makedirs(work_dir, exist_ok=True)\n",
        "\n",
        "    try:\n",
        "        context = \"\"\n",
        "        if zip_file is not None:\n",
        "            zip_path = zip_file if isinstance(zip_file, str) else zip_file.name\n",
        "            safe_extract(zip_path, work_dir)\n",
        "            tree = get_file_tree(work_dir)\n",
        "            tree_str = \"\\n\".join(tree)\n",
        "\n",
        "            sys_prompt_plan = \"\"\"You are a Senior Software Architect.\n",
        "Your task is to analyze the user's request and the project file tree.\n",
        "If the project is empty, design the file structure from scratch (e.g., index.html, style.css, script.js).\n",
        "If the project has files, select ONLY the most relevant files that need to be read or modified.\n",
        "Output exactly in this JSON format:\n",
        "{\"files_to_read\": [\"path/to/file1.py\", \"path/to/file2.html\"]}\n",
        "Do NOT include any other text.\"\"\"\n",
        "\n",
        "            plan_response = call_llm(sys_prompt_plan, f\"Task: {task}\\n\\nFiles:\\n{tree_str}\")\n",
        "\n",
        "            json_match = re.search(r'\\{.*\\}', plan_response, re.DOTALL)\n",
        "            if json_match:\n",
        "                try:\n",
        "                    files_to_read = json_repair.loads(json_match.group(0)).get(\"files_to_read\", [])\n",
        "                    for f in files_to_read:\n",
        "                        file_path = os.path.join(work_dir, f)\n",
        "                        if os.path.exists(file_path) and os.path.isfile(file_path):\n",
        "                            with open(file_path, 'r', encoding='utf-8') as file:\n",
        "                                context += f\"\\n### FILE: {f}\\n```\\n{file.read()}\\n```\\n\"\n",
        "                except:\n",
        "                    pass\n",
        "\n",
        "        # Prompt محدث للمبرمج (منع Template Literals + طلب كود قصير)\n",
        "        sys_prompt_coder = \"\"\"You are an Expert Full-Stack Developer.\n",
        "Your task is to implement the user's request based on the provided context (existing files).\n",
        "If building a web page, write clean, modern, responsive HTML, CSS, and JS. Use modern CSS (Flexbox, Grid) and ensure the design looks professional.\n",
        "CRITICAL RULE 1: Keep the code AS SHORT AND CONCISE AS POSSIBLE. Do not write unnecessary comments or extra features.\n",
        "CRITICAL RULE 2: Do NOT use template literals (backticks ` or ${}) in JavaScript. Use standard string concatenation with quotes (\"\") and the plus (+) operator.\n",
        "If writing Python, write clean, PEP8-compliant code with docstrings.\n",
        "You MUST output a valid JSON object with an 'operations' array. Use EXACT paths.\n",
        "Format:\n",
        "{\n",
        "  \"operations\": [\n",
        "    {\"action\": \"create_file\", \"path\": \"index.html\", \"content\": \"<!DOCTYPE html>...\"}\n",
        "  ]\n",
        "}\n",
        "The content must be the COMPLETE file code, no placeholders. Include all necessary CSS and JS.\n",
        "Output ONLY the JSON.\"\"\"\n",
        "\n",
        "        coder_response = call_llm(sys_prompt_coder, f\"Task: {task}\\n\\nCurrent Code:\\n{context}\")\n",
        "\n",
        "        if coder_response.startswith(\"ERROR:\"):\n",
        "            return f\"❌ فشل الاتصال (Coder): {coder_response}\", \"\", \"\", \"\"\n",
        "\n",
        "        pending_file = os.path.join(session_dir, \"pending_operations.json\")\n",
        "        with open(pending_file, \"w\", encoding=\"utf-8\") as f:\n",
        "            f.write(coder_response)\n",
        "\n",
        "        try:\n",
        "            data = json_repair.loads(coder_response)\n",
        "            if not data or \"operations\" not in data:\n",
        "                json_match_ops = re.search(r'\\{.*\\}', coder_response, re.DOTALL)\n",
        "                if json_match_ops:\n",
        "                    data = json_repair.loads(json_match_ops.group(0))\n",
        "\n",
        "            ops_data = data.get(\"operations\", [])\n",
        "        except:\n",
        "             return f\"⚠️ فشل قراءة JSON.\\n\\n**الرد الخام:**\\n```\\n{coder_response[:1000]}\\n```\", \"\", \"فشل التخطيط\", get_history_list()\n",
        "\n",
        "        if not ops_data:\n",
        "            return f\"⚠️ قائمة العمليات فارغة.\\n\\n**الرد الخام:**\\n```\\n{coder_response[:1000]}\\n```\", \"\", \"فشل التخطيط\", get_history_list()\n",
        "\n",
        "        plan_display = \"✅ تم تحليل الطلب بنجاح.\\n\\n**التعديلات المقترحة (بانتظار موافقتك):**\\n\"\n",
        "        diff_display = \"\"\n",
        "\n",
        "        for op in ops_data:\n",
        "            action = op.get('action')\n",
        "            rel_path = op.get('path')\n",
        "            new_content = op.get('content', '')\n",
        "\n",
        "            new_content = clean_content(new_content)\n",
        "\n",
        "            if not rel_path: continue\n",
        "            plan_display += f\"- [{action}] : {rel_path}\\n\"\n",
        "\n",
        "            file_path = os.path.join(work_dir, rel_path)\n",
        "            old_content = \"\"\n",
        "            if os.path.exists(file_path) and action == \"replace_file\" and os.path.isfile(file_path):\n",
        "                with open(file_path, 'r', encoding='utf-8') as file:\n",
        "                    old_content = file.read()\n",
        "\n",
        "            diff_display += f\"\\n### 📝 Diff for: {rel_path}\\n\"\n",
        "            diff = list(difflib.unified_diff(old_content.splitlines(), new_content.splitlines(), fromfile='Original', tofile='Modified', lineterm=''))\n",
        "\n",
        "            if diff:\n",
        "                for line in diff:\n",
        "                    safe_line = html.escape(line)\n",
        "                    if line.startswith('+') and not line.startswith('+++'):\n",
        "                        diff_display += f\"<span style='color: green;'>{safe_line}</span>\\n\"\n",
        "                    elif line.startswith('-') and not line.startswith('---'):\n",
        "                        diff_display += f\"<span style='color: red;'>{safe_line}</span>\\n\"\n",
        "                    else:\n",
        "                        diff_display += f\"{safe_line}\\n\"\n",
        "            else:\n",
        "                diff_display += \"(ملف جديد)\\n\"\n",
        "\n",
        "        save_history(session_dir, task[:30], task, plan_display, diff_display, \"بانتظار الموافقة\")\n",
        "\n",
        "        return plan_display, diff_display, \"الخطة جاهزة، بانتظار الموافقة.\", get_history_list()\n",
        "\n",
        "    except Exception as e:\n",
        "        return f\"❌ حدث خطأ: {str(e)}\", \"\", \"\", get_history_list()\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# تنفيذ التعديلات واختبارها\n",
        "# ---------------------------------------------------------\n",
        "def execute_project(session_dir):\n",
        "    work_dir = os.path.join(session_dir, \"project_workspace\")\n",
        "    pending_file = os.path.join(session_dir, \"pending_operations.json\")\n",
        "\n",
        "    if not os.path.exists(pending_file) or not os.path.exists(work_dir):\n",
        "        return \"❌ لا توجد خطة محفوظة.\", None, get_history_list()\n",
        "\n",
        "    try:\n",
        "        with open(pending_file, \"r\", encoding=\"utf-8\") as f:\n",
        "            coder_response = f.read()\n",
        "\n",
        "        apply_msg = apply_operations(coder_response, work_dir)\n",
        "        status_log = f\"✅ الموافقة تمت. {apply_msg}\\n\\n⏳ جاري تشغيل الاختبار الأولي...\\n\"\n",
        "        yield status_log, None, get_history_list()\n",
        "\n",
        "        has_py = any(f.endswith('.py') for f in os.listdir(work_dir))\n",
        "\n",
        "        if has_py:\n",
        "            result = subprocess.run([\"pytest\", work_dir, \"-v\", \"--tb=short\"], capture_output=True, text=True, timeout=30)\n",
        "            full_log = result.stdout + \"\\n\" + result.stderr\n",
        "\n",
        "            if result.returncode == 0:\n",
        "                status_log += \"\\n✅ الاختبارات نجحت من أول مرة!\"\n",
        "            else:\n",
        "                status_log += f\"\\n❌ الاختبارات فشلت في الاختبار الأولي.\\n\"\n",
        "                yield status_log, None, get_history_list()\n",
        "\n",
        "                for attempt in range(3):\n",
        "                    status_log += f\"\\n🛠️ محاولة الإصلاح {attempt+1}/3...\\n\"\n",
        "                    yield status_log, None, get_history_list()\n",
        "\n",
        "                    context_after_mod = \"\"\n",
        "                    for root, dirs, files in os.walk(work_dir):\n",
        "                        for file in files:\n",
        "                            if file.endswith(\".py\"):\n",
        "                                full_path = os.path.join(root, file)\n",
        "                                rel_path = os.path.relpath(full_path, work_dir)\n",
        "                                with open(full_path, 'r', encoding='utf-8') as f:\n",
        "                                    context_after_mod += f\"\\n### FILE: {rel_path}\\n```\\n{f.read()}\\n```\\n\"\n",
        "\n",
        "                    sys_prompt_debug = \"\"\"You are a Senior Debugging Specialist.\n",
        "I will give you the current code and the error log.\n",
        "Your task is to fix the bug with the minimal change required.\n",
        "You are FORBIDDEN from modifying test files (files starting with 'test_').\n",
        "Output ONLY a JSON object with the fixed code:\n",
        "{\n",
        "  \"operations\": [\n",
        "    {\"action\": \"replace_file\", \"path\": \"exact/path/to/file.py\", \"content\": \"full fixed code\"}\n",
        "  ]\n",
        "}\"\"\"\n",
        "                    debug_response = call_llm(sys_prompt_debug, f\"Code:\\n{context_after_mod}\\n\\nError:\\n{full_log}\")\n",
        "\n",
        "                    if debug_response.startswith(\"ERROR:\"):\n",
        "                        status_log += f\"\\n❌ فشل الاتصال (Debugger).\\n\"\n",
        "                        break\n",
        "\n",
        "                    apply_operations(debug_response, work_dir)\n",
        "                    result = subprocess.run([\"pytest\", work_dir, \"-v\", \"--tb=short\"], capture_output=True, text=True, timeout=30)\n",
        "                    full_log = result.stdout + \"\\n\" + result.stderr\n",
        "\n",
        "                    if result.returncode == 0:\n",
        "                        status_log += f\"\\n✅ الاختبارات نجحت بعد الإصلاح!\"\n",
        "                        break\n",
        "        else:\n",
        "            status_log += \"\\n✅ لا توجد ملفات بايثون لاختبارها. (تم إنشاء ملفات الويب بنجاح).\"\n",
        "\n",
        "        output_zip = os.path.join(session_dir, \"updated_project.zip\")\n",
        "        with zipfile.ZipFile(output_zip, 'w', zipfile.ZIP_DEFLATED) as zipf:\n",
        "            for root, dirs, files in os.walk(work_dir):\n",
        "                for file in files:\n",
        "                    full_path = os.path.join(root, file)\n",
        "                    rel_path = os.path.relpath(full_path, work_dir)\n",
        "                    zipf.write(full_path, rel_path)\n",
        "\n",
        "        status_log += \"\\n\\n🎁 تم تجهيز الملف النهائي للتحميل.\"\n",
        "\n",
        "        history = load_history()\n",
        "        if session_dir in history:\n",
        "            history[session_dir]['status'] = \"تم بنجاح\"\n",
        "            with open(HISTORY_FILE, \"w\", encoding=\"utf-8\") as f:\n",
        "                json.dump(history, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "        yield status_log, output_zip, get_history_list()\n",
        "\n",
        "    except Exception as e:\n",
        "        yield f\"❌ حدث خطأ: {str(e)}\", None, get_history_list()\n",
        "\n",
        "def get_session_dir():\n",
        "    session_id = str(uuid.uuid4())\n",
        "    session_dir = os.path.join(\"sessions\", session_id)\n",
        "    os.makedirs(session_dir, exist_ok=True)\n",
        "    return session_dir\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# واجهة Gradio\n",
        "# ---------------------------------------------------------\n",
        "with gr.Blocks(title=\"AI-Workforce v2.3.2 (Pro)\") as iface:\n",
        "    gr.Markdown(\"# 🏗️ AI-Workforce v2.3.2: Professional Builder\")\n",
        "\n",
        "    session_state = gr.State(get_session_dir())\n",
        "\n",
        "    with gr.Sidebar(label=\"المحادثات السابقة (History)\", open=True):\n",
        "        gr.Markdown(\"### 📜 سجل المحادثات\")\n",
        "        history_list = gr.Radio(choices=get_history_list(), label=\"اختر محادثة سابقة\", interactive=True)\n",
        "        load_btn = gr.Button(\"🔄 تحميل المحادثة\")\n",
        "        refresh_btn = gr.Button(\"🔄 تحديث القائمة\")\n",
        "\n",
        "    with gr.Row():\n",
